      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is Prompt Health?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prompt is the AI-powered Electronic Medical Record (EMR) and practice management platform for physical therapy, occupational therapy, speech-language pathology, and chiropractic practices. But beyond the tech, we're the business partner you didn't know you needed. While most EMRs store your data, Prompt acts on it. Before the visit, in the room, and after the visit, Prompt's AI handles the work between your decisions and pauses when your judgment matters. You stay in complete control.\n\nPrompt was founded in 2017 by Mike Dwyer and Adam Baliatico to give clinics one unified platform for documentation, scheduling, billing, and practice management, instead of stitching together a handful of separate tools. Today we're used by more than 1,000 outpatient rehab therapy practices across the United States."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Prompt Health located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We're headquartered in Hoboken, New Jersey, and we serve clinics across the United States."
          }
        },
        {
          "@type": "Question",
          "name": "How long has Prompt Health been around?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We were founded in 2017 and launched our first product in 2019, so we've been serving rehab therapy practices for several years now and through many generations of the product."
          }
        }
      ]
    }
